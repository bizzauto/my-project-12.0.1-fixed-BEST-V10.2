# Database (PostgreSQL / Supabase Self-Hosted)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Node Environment (production | development)
NODE_ENV=production

# JWT Authentication (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32"
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
RESELLER_JWT_SECRET="generate-with-openssl-rand-hex-32"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-change-in-prod"
NEXTAUTH_URL="https://your-domain.com"

# Frontend & CORS (REQUIRED for production)
FRONTEND_URL="https://your-domain.com"
BASE_URL="https://your-domain.com"
CORS_ORIGIN="https://your-domain.com,https://www.your-domain.com"

# Server
PORT=4000
HOST=0.0.0.0

# Cron
CRON_SECRET="your-cron-secret-here"

# Redis (optional - for background jobs)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_ENABLED="false"

# AI Services
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Analytics
VITE_POSTHOG_API_KEY=""
VITE_POSTHOG_HOST=""

# Push Notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
